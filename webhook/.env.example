# Webhook Service Configuration Example
# Copy this file to .env and update with your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Database Configuration
DB_USER=propoff
DB_PASSWORD=student
DB_HOST=localhost
DB_PORT=5432
DB_NAME=propertyoffice
DB_SCHEMA=public

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Cheqroom Webhook Configuration
# ⚠️  CRITICAL: This must match the secret configured in Cheqroom dashboard
CHEQROOM_WEBHOOK_SECRET=your_webhook_secret_here

# Webhook endpoint path
WEBHOOK_PATH=/webhooks/cheqroom

# Logging
LOG_LEVEL=INFO

# Cheqroom API (optional, for future integrations)
CHEQROOM_API_URL=https://api.cheqroom.com/api
CHEQROOM_API_TOKEN=your_api_token_here
